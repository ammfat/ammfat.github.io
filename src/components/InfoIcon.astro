---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
  class:list={['inline-block h-3.5 w-3.5 shrink-0', className]}
>
  <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.25"></circle>
  <circle cx="8" cy="5.25" r="0.75" fill="currentColor"></circle>
  <path d="M8 7.5v4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
</svg>
