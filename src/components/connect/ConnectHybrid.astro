---
import Elsewhere from '../Elsewhere.astro';
import { site } from '../../content/site';

interface Props {
  class?: string;
  showCopyright?: boolean;
}

const { class: className = '', showCopyright = true } = Astro.props;
---

<footer class:list={['text-sm text-[#6b6458]', className]}>
  <p class="font-[family-name:var(--font-display)] text-xl font-medium text-[#1c1a16]">
    {site.openTo}
  </p>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <a
      href={site.links.email}
      class="rounded-sm border border-[#cfc6b6] bg-[#f7f4ee] px-4 py-2.5 text-sm font-medium text-[#1c1a16] hover:border-[#8a8070]"
    >
      Email me
    </a>
    <p class="inline-flex items-center gap-2 text-[#3d3930]">
      <a href={site.links.email} class="underline decoration-[#cfc6b6] hover:text-[#1c1a16]">
        {site.email}
      </a>
      <button
        type="button"
        class="inline-flex h-7 w-7 items-center justify-center rounded-sm border border-[#cfc6b6] text-[#6b6458] hover:border-[#8a8070] hover:text-[#1c1a16]"
        data-copy-email={site.email}
        aria-label="Copy email"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.25"></rect>
          <path d="M3.5 10.5V3.5h7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
        </svg>
        <span class="sr-only" data-copy-label>Copy</span>
      </button>
    </p>
  </div>
  <Elsewhere
    class="mt-4 text-[#3d3930]"
    linkClass="underline decoration-[#cfc6b6] hover:text-[#1c1a16]"
  />
  {
    showCopyright && (
      <p class="mt-3">
        © {site.copyrightYear} {site.shortName}
      </p>
    )
  }
</footer>
