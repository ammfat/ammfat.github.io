---
import Base from '../../layouts/Base.astro';
import Elsewhere from '../../components/Elsewhere.astro';
import ConceptNav from '../../components/ConceptNav.astro';
import { site } from '../../content/site';
import { stackGroups } from '../../content/stack';
import { roles } from '../../content/roles';
import { focusAreas } from '../../content/focus';
import { getProjects } from '../../lib/projects';
import { proficiencyLabel, projectLayers } from '../../lib/labels';
import { render } from 'astro:content';

const projects = await getProjects();
const rendered = await Promise.all(
  projects.map(async (p) => ({
    ...p,
    Content: (await render(p)).Content,
  })),
);

const identityLines = [
  ['status', 'OK'],
  ['host', site.shortName],
  ['name', site.name],
  ['role', site.role],
  ['loc', site.location],
  ['cert', 'ClickHouse Certified Developer'],
  ...site.metrics.map((m) => [m.label, m.value] as const),
];
const identityPad = Math.max(...identityLines.map(([k]) => k.length));
const identityPre = identityLines
  .map(([k, v]) => `${k.padEnd(identityPad)}  ${v}`)
  .join('\n');
---

<Base
  title={`${site.shortName} · operator`}
  description={site.tagline}
  bodyClass="bg-[#0c0e0c] text-[#c8d0c4] font-mono antialiased min-h-screen"
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <main class="mx-auto max-w-3xl px-4 py-8 text-[13px] leading-relaxed sm:px-6 sm:py-12 sm:text-sm">
    <ConceptNav current="a" class="mb-6 text-[#6a7568] [&_a]:underline [&_a]:decoration-[#2a3028] hover:[&_a]:text-[#c8d0c4] [&_[aria-current=page]]:text-[#e4eadc] [&_[aria-current=page]]:font-medium" />

    <header class="border border-[#2a3028] bg-[#101410] p-4 sm:p-5">
      <pre class="overflow-x-auto whitespace-pre text-[#9aab94]">{identityPre}</pre>
      <p class="mt-4 max-w-prose text-[#c8d0c4]">{site.tagline}</p>
    </header>

    <section class="mt-8" aria-labelledby="focus-heading">
      <h2 id="focus-heading" class="mb-3 text-[#6a7568]"># focus</h2>
      <ul class="space-y-3">
        {
          focusAreas.map((f) => (
            <li>
              <p class="font-medium text-[#e4eadc]">{f.title}</p>
              <p class="text-[#a8b4a4]">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-8" aria-labelledby="work-heading">
      <h2 id="work-heading" class="mb-3 text-[#6a7568]"># projects</h2>
      <ul class="space-y-0 border border-[#2a3028]">
        {
          rendered.map((p) => (
            <li class="border-b border-[#2a3028] last:border-b-0">
              <details class="group open:bg-[#101410]">
                <summary class="cursor-pointer list-none px-3 py-2 hover:bg-[#141814] [&::-webkit-details-marker]:hidden">
                  <span class="text-[#7d9a6e]">[{projectLayers(p.data).join(' · ')}]</span>{' '}
                  <span class="font-medium text-[#e4eadc]">{p.data.title}</span>
                  {p.data.closed ? (
                    <span class="text-[#6a7568]"> · closed source</span>
                  ) : (
                    <span class="text-[#6a7568]"> · public</span>
                  )}
                </summary>
                <div class="space-y-2 border-t border-[#2a3028] px-3 py-3 text-[#a8b4a4]">
                  <p class="text-[#c8d0c4]">{p.data.summary}</p>
                  <div class="[&_p]:mb-2 [&_strong]:font-medium [&_strong]:text-[#e4eadc]">
                    <p.Content />
                  </div>
                  <p class="text-[#6a7568]">
                    stack: {p.data.stack.join(' · ')}
                    {p.data.repo && (
                      <>
                        {' · '}
                        <a class="text-[#9aab94] underline" href={p.data.repo} rel="noopener noreferrer">
                          GitHub
                        </a>
                      </>
                    )}
                  </p>
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-8" aria-labelledby="stack-heading">
      <h2 id="stack-heading" class="mb-3 text-[#6a7568]"># stack and proficiency</h2>
      <div class="space-y-5">
        {
          stackGroups.map((group) => (
            <div>
              <h3 class="mb-1 text-[#9aab94]">{group.label}</h3>
              <ul class="font-mono">
                {group.items.map((item) => (
                  <li class="flex justify-between gap-4 border-b border-dotted border-[#2a3028] py-0.5">
                    <span>
                      {item.name}
                      {item.note && <span class="text-[#6a7568]"> — {item.note}</span>}
                    </span>
                    <span class="shrink-0 text-[#6a7568]">{proficiencyLabel[item.depth]}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-8" aria-labelledby="roles-heading">
      <h2 id="roles-heading" class="mb-3 text-[#6a7568]"># roles</h2>
      <ul class="space-y-4">
        {
          roles.map((role) => (
            <li>
              <p class="text-[#e4eadc]">
                {role.title} <span class="text-[#6a7568]">@</span> {role.org}
              </p>
              <p class="text-[#6a7568]">
                {role.start} → {role.end} · {role.location}
              </p>
              <ul class="mt-1 list-none space-y-0.5 text-[#a8b4a4]">
                {role.bullets.slice(0, 2).map((b) => (
                  <li>— {b}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="mt-10 border-t border-[#2a3028] pt-4 text-[#6a7568]">
      <p class="mt-0">{site.openTo}</p>
      <Elsewhere class="mt-2 text-[#9aab94]" />
      <p class="mt-2">© {site.copyrightYear} {site.shortName}</p>
    </footer>
  </main>
</Base>
