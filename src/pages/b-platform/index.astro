---
import Base from '../../layouts/Base.astro';
import Elsewhere from '../../components/Elsewhere.astro';
import ConceptNav from '../../components/ConceptNav.astro';
import InfoIcon from '../../components/InfoIcon.astro';
import { site } from '../../content/site';
import { stackGroups } from '../../content/stack';
import { focusAreas } from '../../content/focus';
import { getProjects } from '../../lib/projects';
import { proficiencyLabel, projectLayers } from '../../lib/labels';
import { render } from 'astro:content';

const projects = await getProjects();
const rendered = await Promise.all(
  projects.map(async (p) => {
    const layers = projectLayers(p.data);
    return {
      ...p,
      layers,
      Content: (await render(p)).Content,
    };
  }),
);

const layers = stackGroups.map((g) => ({ id: g.id, label: g.label }));

const flowNodes = [
  { id: 'ingestion', label: 'Sources &\ningest', x: 20 },
  { id: 'storage', label: 'Warehouse\n& query', x: 160 },
  { id: 'orchestration', label: 'Orchestration', x: 300 },
  { id: 'analytics', label: 'BI &\nAPIs', x: 440 },
  { id: 'ai', label: 'Agents', x: 580 },
] as const;
---

<Base
  title={`${site.shortName} · platform`}
  description={site.tagline}
  bodyClass="bg-[#f4f1eb] text-[#1c1a16] font-sans antialiased min-h-screen"
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&display=swap"
    rel="stylesheet"
  />

  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6" id="platform-root" data-filter="">
    <ConceptNav current="b" class="mb-6 text-sm text-[#6b6458] [&_a]:underline [&_a]:decoration-[#cfc6b6] hover:[&_a]:text-[#1c1a16] [&_[aria-current=page]]:text-[#1c1a16] [&_[aria-current=page]]:font-medium" />

    <header class="mb-10 max-w-2xl">
      <p class="font-[family-name:var(--font-display)] text-3xl font-medium tracking-tight text-[#1c1a16] sm:text-4xl">
        {site.name}
      </p>
      <p class="mt-2 text-lg text-[#3d3930]">{site.role}</p>
      <p class="mt-4 text-[#4a453c]">{site.tagline}</p>
      <p class="mt-3 text-sm text-[#6b6458]">{site.headline}</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-[#6b6458]">
        {
          site.metrics.map((m) => (
            <li>
              <span class="uppercase tracking-wide">{m.label}</span>{' '}
              <span class="font-semibold text-[#1c1a16]">{m.value}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <section class="mb-12" aria-labelledby="focus-heading">
      <h2 id="focus-heading" class="font-[family-name:var(--font-display)] text-xl font-medium">
        Focus
      </h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          focusAreas.map((f) => (
            <li>
              <p class="font-semibold text-[#1c1a16]">{f.title}</p>
              <p class="mt-1 text-sm text-[#4a453c]">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-12" aria-labelledby="diagram-heading">
      <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
        <h2 id="diagram-heading" class="font-[family-name:var(--font-display)] text-xl font-medium">
          The platform
        </h2>
        <p class="inline-flex items-center gap-1.5 text-sm text-[#6b6458]">
          <InfoIcon />
          <span>
            Click a layer to filter stack and work.
            <button
            type="button"
            id="clear-filter"
            class="ml-2 hidden underline decoration-[#cfc6b6]"
            data-clear
          >
              Clear
            </button>
          </span>
        </p>
      </div>

      <div class="overflow-x-auto rounded-sm border border-[#d9d0c0] bg-[#ebe6dc] p-4 sm:p-6" id="diagram">
        <svg
          viewBox="0 0 720 220"
          class="mx-auto h-auto w-full min-w-[520px] max-w-3xl"
          role="img"
          aria-label="Data platform layers from sources through agents"
        >
          <defs>
            <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
              <path d="M0,0 L6,3 L0,6 Z" fill="#8a8070"></path>
            </marker>
          </defs>
          {
            flowNodes.map((node, i, arr) => (
              <>
                <g
                  class="layer-node cursor-pointer"
                  data-layer={node.id}
                  tabindex="0"
                  role="button"
                  aria-pressed="false"
                  aria-label={`Filter by ${node.label.replace('\n', ' ')}`}
                >
                  <rect
                    x={node.x}
                    y="70"
                    width="120"
                    height="72"
                    rx="4"
                    class="fill-[#f7f4ee] stroke-[#8a8070] stroke-[1.5] transition-colors"
                  />
                  <text
                    x={node.x + 60}
                    y="98"
                    text-anchor="middle"
                    class="fill-[#1c1a16] text-[13px] font-semibold"
                    style="font-family: var(--font-sans); white-space: pre"
                  >
                    {node.label.split('\n').map((line, li) => (
                      <tspan x={node.x + 60} dy={li === 0 ? 0 : 16}>
                        {line}
                      </tspan>
                    ))}
                  </text>
                </g>
                {i < arr.length - 1 && (
                  <line
                    x1={node.x + 120}
                    y1="106"
                    x2={arr[i + 1].x}
                    y2="106"
                    stroke="#8a8070"
                    stroke-width="1.5"
                    marker-end="url(#arrow)"
                  />
                )}
              </>
            ))
          }
          <g
            class="layer-node cursor-pointer"
            data-layer="platform"
            tabindex="0"
            role="button"
            aria-pressed="false"
            aria-label="Filter by platform and ops"
          >
            <rect
              x="160"
              y="168"
              width="400"
              height="36"
              rx="4"
              class="fill-[#e4ddd0] stroke-[#8a8070] stroke-[1.5]"
            />
            <text
              x="360"
              y="191"
              text-anchor="middle"
              class="fill-[#1c1a16] text-[13px] font-semibold"
              style="font-family: var(--font-sans)"
            >
              Platform & ops (Linux · Docker · Ansible)
            </text>
          </g>
        </svg>
      </div>

      <ul class="mt-4 flex flex-wrap gap-2" id="layer-chips" aria-label="Filter by layer">
        {
          layers.map((layer) => (
            <li>
              <button
                type="button"
                class="layer-chip rounded-sm border border-[#cfc6b6] bg-[#f7f4ee] px-2.5 py-1 text-sm text-[#3d3930] hover:border-[#8a8070]"
                data-layer={layer.id}
                aria-pressed="false"
              >
                {layer.label}
              </button>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="grid gap-12 lg:grid-cols-2">
      <section aria-labelledby="stack-heading">
        <h2 id="stack-heading" class="font-[family-name:var(--font-display)] text-xl font-medium">
          Stack and proficiency
        </h2>
        <p class="mt-1 text-sm text-[#6b6458]">
          Grouped by where it sits in the platform. Proficiency: production / personal projects / exploring.
        </p>
        <div class="mt-6 space-y-6">
          {
            stackGroups.map((group) => (
              <div class="stack-group" data-layer={group.id}>
                <h3 class="text-sm font-semibold uppercase tracking-wide text-[#6b6458]">{group.label}</h3>
                <ul class="mt-2 space-y-1">
                  {group.items.map((item) => (
                    <li class="flex justify-between gap-3 border-b border-[#e0d8c8] py-1 text-sm">
                      <span>
                        {item.name}
                        {item.note && <span class="text-[#6b6458]"> — {item.note}</span>}
                      </span>
                      <span class="shrink-0 text-[#8a8070]">{proficiencyLabel[item.depth]}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="work-heading">
        <h2 id="work-heading" class="font-[family-name:var(--font-display)] text-xl font-medium">
          Projects
        </h2>
        <ul class="mt-6 space-y-6">
          {
            rendered.map((p) => (
              <li class="work-item border-t border-[#d9d0c0] pt-4" data-layers={p.layers.join(' ')}>
                <h3 class="font-semibold text-[#1c1a16]">{p.data.title}</h3>
                <p class="mt-1 text-sm text-[#6b6458]">
                  {p.layers.join(' · ')}
                  {p.data.closed ? ' · closed source' : ' · public'}
                  {p.data.repo && (
                    <>
                      {' · '}
                      <a
                        class="underline decoration-[#cfc6b6] hover:text-[#1c1a16]"
                        href={p.data.repo}
                        rel="noopener noreferrer"
                      >
                        GitHub
                      </a>
                    </>
                  )}
                </p>
                <p class="mt-2 text-[#3d3930]">{p.data.summary}</p>
                <div class="mt-2 text-sm text-[#4a453c] [&_p]:mb-2 [&_strong]:font-semibold">
                  <p.Content />
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <footer class="mt-16 border-t border-[#d9d0c0] pt-6 text-sm text-[#6b6458]">
      <p class="mt-0">{site.openTo}</p>
      <Elsewhere
        class="mt-3 text-[#3d3930]"
        linkClass="underline decoration-[#cfc6b6] hover:text-[#1c1a16]"
      />
      <p class="mt-3">© {site.copyrightYear} {site.shortName}</p>
    </footer>
  </main>

  <style>
    #platform-root .layer-node.is-active > rect {
      fill: #1c1a16;
      stroke: #1c1a16;
    }

    #platform-root .layer-node.is-active text {
      fill: #f4f1eb;
    }

    #platform-root .layer-chip.is-active {
      border-color: #1c1a16;
      background: #1c1a16;
      color: #f4f1eb;
    }
  </style>

  <script>
    const root = document.getElementById('platform-root');
    const clearBtn = document.getElementById('clear-filter');
    if (!root) throw new Error('platform root missing');

    function setFilter(layer: string | null) {
      root.dataset.filter = layer ?? '';
      clearBtn?.classList.toggle('hidden', !layer);

      document.querySelectorAll<HTMLElement>('[data-layer], [data-layers]').forEach((el) => {
        const isControl = el.classList.contains('layer-node') || el.classList.contains('layer-chip');
        if (isControl) {
          const active = !!layer && el.dataset.layer === layer;
          el.setAttribute('aria-pressed', active ? 'true' : 'false');
          el.classList.toggle('is-active', active);
          return;
        }

        if (el.classList.contains('stack-group')) {
          const match = !layer || el.dataset.layer === layer;
          el.classList.toggle('hidden', !match);
          return;
        }

        if (el.classList.contains('work-item')) {
          const projectLayers = (el.dataset.layers ?? '').split(/\s+/).filter(Boolean);
          const match = !layer || projectLayers.includes(layer);
          el.classList.toggle('hidden', !match);
        }
      });
    }

    function onActivate(el: Element) {
      const layer = (el as HTMLElement).dataset.layer;
      if (!layer) return;
      const current = root.dataset.filter;
      setFilter(current === layer ? null : layer);
    }

    document.querySelectorAll('.layer-node, .layer-chip').forEach((el) => {
      el.addEventListener('click', () => onActivate(el));
      el.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          onActivate(el);
        }
      });
    });

    clearBtn?.addEventListener('click', () => setFilter(null));
  </script>
</Base>
