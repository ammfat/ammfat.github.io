---
import Base from '../../layouts/Base.astro';
import ConceptNav from '../../components/ConceptNav.astro';
import ConnectQuiet from '../../components/connect/ConnectQuiet.astro';
import ConnectStack from '../../components/connect/ConnectStack.astro';
import ConnectDossier from '../../components/connect/ConnectDossier.astro';
import ConnectHybrid from '../../components/connect/ConnectHybrid.astro';
import { site } from '../../content/site';

const variants = [
  {
    id: 'quiet',
    name: 'Quiet',
    blurb: 'Invite line, visible mailto + copy icon, text socials.',
    Component: ConnectQuiet,
  },
  {
    id: 'stack',
    name: 'Stack',
    blurb: 'Equal outline actions: Email me, Copy email, then socials.',
    Component: ConnectStack,
  },
  {
    id: 'dossier',
    name: 'Dossier',
    blurb: 'Two-column about + labeled facts + Email / LinkedIn actions. Now on /b2/.',
    Component: ConnectDossier,
  },
  {
    id: 'hybrid',
    name: 'Hybrid',
    blurb: 'Outline Email me beside address + copy; text socials.',
    Component: ConnectHybrid,
  },
] as const;
---

<Base
  title={`${site.shortName} · connect CTAs`}
  description="B2 Connect CTA variants for local comparison."
  bodyClass="bg-[#f4f1eb] text-[#1c1a16] font-sans antialiased min-h-screen"
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&display=swap"
    rel="stylesheet"
  />
  <style slot="head" is:global>
    :root {
      --font-sans: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif;
      --font-display: 'Fraunces', ui-serif, Georgia, serif;
    }
    body {
      font-family: var(--font-sans);
    }
  </style>

  <main class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
    <ConceptNav
      current="cta"
      class="mb-6 text-sm text-[#6b6458] [&_a]:underline [&_a]:decoration-[#cfc6b6] hover:[&_a]:text-[#1c1a16] [&_[aria-current=page]]:font-medium [&_[aria-current=page]]:text-[#1c1a16]"
    />

    <p class="text-sm text-[#6b6458]">Local review only · B2 Connect CTAs</p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-medium tracking-tight text-[#1c1a16]">
      Pick a connect pattern
    </h1>
    <p class="mt-3 max-w-prose text-[#3d3930]">
      Same cream/ink skin as <a href="/b2/" class="underline decoration-[#cfc6b6]">/b2/</a>. Dossier is
      live on B2; Quiet, Stack, and Hybrid stay here as archive.
    </p>

    <div class="mt-12 space-y-14">
      {
        variants.map(({ id, name, blurb, Component }) => (
          <section aria-labelledby={`cta-${id}`}>
            <div class="mb-4 border-b border-[#d9d0c0] pb-2">
              <h2
                id={`cta-${id}`}
                class="font-[family-name:var(--font-display)] text-xl font-medium text-[#1c1a16]"
              >
                {name}
              </h2>
              <p class="mt-1 text-sm text-[#6b6458]">{blurb}</p>
            </div>
            <Component showCopyright={true} />
          </section>
        ))
      }
    </div>
  </main>

  <script>
    import { initConnectCopy } from '../../lib/connect-copy';
    initConnectCopy();
  </script>
</Base>
